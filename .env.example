# Optional: provide a WalletConnect Cloud project ID to enable WalletConnect wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Protocol chain for the dapp (10143 = Monad Testnet, 20143 = local Solonet).
NEXT_PUBLIC_CHAIN_ID=10143

# Optional: override the public Monad Testnet RPC endpoint.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: override the local Solonet RPC endpoint for the browser.
# Use the CORS-enabled nginx proxy (default). Direct :48080 is fine for cast/wallets.
NEXT_PUBLIC_SOLONET_RPC_URL=http://127.0.0.1:48082/rpc/

# Optional: point the server-side indexer proxy at an Envio Cloud GraphQL endpoint.
# Local development defaults to http://127.0.0.1:8080/v1/graphql.
ENVIO_GRAPHQL_ENDPOINT=
ENVIO_GRAPHQL_AUTH_TOKEN=
ENVIO_GRAPHQL_ADMIN_SECRET=

# Dev burner wallet (Scaffold-ETH style). Enabled automatically on Solonet (20143).
NEXT_PUBLIC_ENABLE_BURNER_WALLET=
NEXT_PUBLIC_ENABLE_FAUCET=

# Server-only Solonet faucet (never use NEXT_PUBLIC_ for the private key).
# Defaults to Anvil account #0 when running against local Solonet.
FAUCET_PRIVATE_KEY=
FAUCET_AMOUNT_MON=1000
FAUCET_ENABLED=
SOLONET_RPC=http://127.0.0.1:48080
