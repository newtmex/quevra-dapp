# Optional: provide a WalletConnect Cloud project ID to enable WalletConnect wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Protocol chain for the dapp (10143 = Monad Testnet, 20143 = local Solonet).
NEXT_PUBLIC_CHAIN_ID=10143

# Optional: override the public Monad Testnet RPC endpoint.
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Optional: override the local Solonet RPC endpoint (default http://127.0.0.1:48080).
NEXT_PUBLIC_SOLONET_RPC_URL=http://127.0.0.1:48080

# Optional: point the server-side indexer proxy at an Envio Cloud GraphQL endpoint.
# Local development defaults to http://127.0.0.1:8080/v1/graphql.
ENVIO_GRAPHQL_ENDPOINT=
ENVIO_GRAPHQL_AUTH_TOKEN=
ENVIO_GRAPHQL_ADMIN_SECRET=
